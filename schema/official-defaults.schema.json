{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DancingMusic/DancingStore/main/schema/official-defaults.schema.json",
  "title": "DancingStore Official Defaults Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "channel", "revision", "plugins", "updatedAt"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1" },
    "id": { "const": "official-defaults" },
    "channel": { "enum": ["stable", "beta"] },
    "revision": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "defaultPluginId": { "$ref": "#/$defs/id" },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "plugins": { "type": "array", "minItems": 1 } }, "required": ["plugins"] },
      "then": { "properties": { "defaultPluginId": { "$ref": "#/$defs/id" } }, "required": ["defaultPluginId"] },
      "else": { "not": { "required": ["defaultPluginId"] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "order", "installMode", "updatePolicy"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "order": { "type": "integer", "minimum": 0 },
        "installMode": { "enum": ["preinstalled", "recommended"] },
        "updatePolicy": { "const": "notify" }
      }
    }
  }
}
