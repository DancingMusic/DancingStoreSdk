{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DancingMusic/DancingStore/main/schema/official-catalog.schema.json",
  "title": "DancingMusic official plugin catalog profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "entries", "updatedAt"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1" },
    "id": { "const": "official-plugins" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
          "state": { "enum": ["publish", "withdraw"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "at": { "type": "string", "format": "date-time" }
        },
        "allOf": [{
          "if": { "properties": { "state": { "const": "withdraw" } } },
          "then": {
            "properties": {
              "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
              "at": { "type": "string", "format": "date-time" }
            },
            "required": ["reason", "at"]
          },
          "else": {
            "properties": {
              "reason": false,
              "at": false
            }
          }
        }]
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
